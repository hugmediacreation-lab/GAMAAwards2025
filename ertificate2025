    <script>
        <?php
            $upload_dir = wp_upload_dir();
            $path = $upload_dir['basedir'] . '/2025/08/';
            $files = glob($path . '*.{png,jpg,jpeg}', GLOB_BRACE);
            $originals = [];
            $scaled_versions = [];
            foreach ($files as $file) {
                if (preg_match('/-\d+x\d+\.(png|jpg|jpeg)$/i', $file)) { continue; }
                if (strpos(basename($file), '-scaled') !== false) {
                    $base_name = str_replace('-scaled', '', basename($file));
                    $scaled_versions[$base_name] = basename($file);
                } else {
                    $originals[$base_name] = basename($file);
                }
            }
            $final_files = array_merge($originals, $scaled_versions);
            $file_names = array_values($final_files);
            echo "const certificateFiles = " . json_encode($file_names) . ";\n";
        ?>
        const certificateBaseUrl = "<?php echo content_url('/uploads/2025/08/'); ?>";
        const searchInput = document.getElementById('searchInput');
        const searchButton = document.getElementById('searchButton');
        const resultsContainer = document.getElementById('results-container');
        function performSearch() {
            const searchTerm = searchInput.value.toLowerCase().replace(/\s+/g, '');
            if (searchTerm.length < 3) {
                resultsContainer.innerHTML = `<p style="color:var(--white); text-align:center;">กรุณากรอกข้อความค้นหาอย่างน้อย 3 ตัวอักษร</p>`;
                return;
            }
            const foundFiles = certificateFiles.filter(fileName => {
                const searchableName = fileName.toLowerCase().replace(/-/g, '').replace(/scaled/g, '');
                return searchableName.includes(searchTerm);
            });
            displayResults(foundFiles);
        }
        function displayResults(results) {
            resultsContainer.innerHTML = '';
            if (results.length === 0) {
                resultsContainer.innerHTML = `<p style="color:var(--white); text-align:center;">ไม่พบข้อมูลที่ตรงกับการค้นหา</p>`;
                return;
            }
            results.forEach(fileName => {
                const fileUrl = certificateBaseUrl + encodeURIComponent(fileName);
                let displayName = fileName.substring(0, fileName.lastIndexOf('.')).replace(/-/g, ' ');
                displayName = displayName.replace(/ scaled/g, '');
                const item = document.createElement('div');
                item.className = 'result-item';
                item.innerHTML = `
                    <strong class="result-title">${displayName}</strong>
                    <a href="${fileUrl}" class="preview-link" download="${fileName}">
                        <img src="${fileUrl}" alt="ตัวอย่างใบประกาศของ ${displayName}" class="preview-image">
                    </a>
                    <a href="${fileUrl}" class="download-btn" download="${fileName}">
                        <i class="fa-solid fa-download"></i>
                        ดาวน์โหลด
                    </a>
                `;
                resultsContainer.appendChild(item);
            });
        }
        searchButton.addEventListener('click', performSearch);
        searchInput.addEventListener('keyup', (event) => {
            if (event.key === 'Enter') {
                performSearch();
            }
        });
    </script>
</body>
